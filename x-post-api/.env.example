# x-post-api の設定
# このファイルを .env にコピーし、値を変更して chmod 600 にする。
# .env は git にコミットしないこと。

# 32 バイト以上の ASCII ランダム値（例: openssl rand -hex 32）
# 未設定のままでは起動しない（下の change-me は 32 バイト未満）
X_API_TOKEN=change-me

# 投稿先の X ハンドル（@ なし）
X_ACCOUNT=your_account

# HTTP API
X_API_PORT=8788
X_API_BIND=127.0.0.1
X_API_LOG_PATH=logs/x-api.ndjson
X_API_RATE_LIMIT=10
X_API_RATE_WINDOW_SEC=3600
X_API_MIN_INTERVAL_SEC=10
X_API_ALLOWED_ORIGINS=https://amay077.github.io,http://localhost:8080,http://127.0.0.1:8080
X_API_LOCK_PATH=.x-post-api.lock
X_API_REQUEST_TIMEOUT_SEC=20
X_API_LOCK_TIMEOUT_SEC=20

# launchd のラッパーが使用する Python（macOS 標準は /usr/bin/python3）
X_API_PYTHON=/usr/bin/python3

# Docker の Tailscale コンテナ
TS_AUTHKEY=tskey-auth-replace-me
